[Unit]
Description=NervesHub device agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nerves-hub-link-agent --config /etc/nerves-hub-link-agent.toml
Restart=always
RestartSec=5
Environment=RUST_LOG=nerves_hub_link_agent=info

# The agent downloads from the network and runs support scripts, so it does not
# run as root. RuntimeDirectory gives it /run/nerves-hub-link-agent for the IPC
# socket, owned by this user and recreated each boot.
User=agent
Group=agent

# The logging extension shells out to `journalctl --follow`, which reads
# nothing without this group -- and reports it as a tail that "ended", which
# looks like an empty journal rather than a permission it does not have.
#
# Granted here rather than in the user database. GROUPMEMS_PARAM runs against
# the recipe's own sysroot, which knows only the groups the recipe creates, so
# it cannot see a group systemd owns: "group 'systemd-journal' does not exist".
# systemd resolves this at start, when it certainly does.
SupplementaryGroups=systemd-journal
RuntimeDirectory=nerves-hub-link-agent
StateDirectory=nerves-hub-link-agent

[Install]
WantedBy=multi-user.target

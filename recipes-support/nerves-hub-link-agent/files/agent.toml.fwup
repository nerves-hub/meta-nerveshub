# Shipped by the nerves-hub-link-agent recipe as a starting point. Config is
# firmware: it versions with the image and is replaced by an update, so a real
# product overrides this from its own layer rather than editing it on a device.
#
# See examples/agent.toml in the source tree for every option, annotated.

[server]
host = "@NERVES_HUB_HOST@"
port = @NERVES_HUB_PORT@
tls = true
path = "/device-socket"

[identity]
product_key = "@NERVES_HUB_LINK_AGENT_PRODUCT_KEY@"
product_secret = "NERVES_HUB_LINK_AGENT_PRODUCT_SECRET"
# An update overwrites the whole rootfs slot, so the identifier lives somewhere
# that survives one. Reading it from the hardware is better where the hardware
# has one: { file = "/sys/firmware/devicetree/base/serial-number" }
identifier = { file = "/data/nerves-hub/identifier" }

[update_tool]
name = "fwup"
binary = "/usr/bin/fwup"

[ipc]
socket = "/run/nerves-hub-link-agent/agent.sock"

[updates]
policy = "apply"

[reboot]
policy = "immediate"
command = "reboot"
